  "engineered_features": [
    {
      "name": "CREDIT_INCOME_RATIO",
      "formula": "AMT_CREDIT / AMT_INCOME_TOTAL",
      "description": "Total loan leverage relative to borrower annual income"
    },
    {
      "name": "ANNUITY_INCOME_RATIO",
      "formula": "AMT_ANNUITY / AMT_INCOME_TOTAL",
      "description": "Debt service payment burden as percentage of annual income"
    },
    {
      "name": "PAYMENT_RATE",
      "formula": "AMT_ANNUITY / AMT_CREDIT",
      "description": "Amortization rate / repayment speed proxy"
    },
    {
      "name": "EXT_SOURCES_MEAN",
      "formula": "Mean(EXT_SOURCE_1, EXT_SOURCE_2, EXT_SOURCE_3)",
      "description": "Composite normalized external credit score"
    },
    {
      "name": "DAYS_EMPLOYED_PERC",
      "formula": "DAYS_EMPLOYED / DAYS_BIRTH",
      "description": "Employment tenure as a fraction of applicant age"
    }
